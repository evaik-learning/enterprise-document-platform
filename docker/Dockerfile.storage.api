FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ../src/Services/Storage/Edp.Storage.Api/Edp.Storage.Api.csproj ./
RUN dotnet restore "Edp.Storage.Api.csproj"
COPY ../src/Services/Storage/Edp.Storage.Api/. ./
RUN dotnet publish "Edp.Storage.Api.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Edp.Storage.Api.dll"]
